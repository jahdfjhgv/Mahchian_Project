# Вариант 18. Задание 2. Даны целые положительные числа A и B (A < B). Вывести все целые числа от A до B включительно; при этом каждое число должно выводиться столько раз, каково его значение (например, число 3 выводится 3 раза).

try:
    a = input("Введите целое положительное число A: ")
    while type(a) != int:
        try:
            a = int(a)
            if a <= 0:
                print("Число должно быть положительным!")
                a = input("Введите целое положительное число A: ")
        except ValueError:
            print("Неправильно ввели!")
            a = input("Введите целое положительное число A: ")

    b = input("Введите целое положительное число B (B > A): ")
    while type(b) != int:
        try:
            b = int(b)
            if b <= a:
                print("Число B должно быть больше A!")
                b = input("Введите целое положительное число B (B > A): ")
        except ValueError:
            print("Неправильно ввели!")
            b = input("Введите целое положительное число B (B > A): ")

    current = a
    while current <= b:
        count = 0
        while count < current:
            print(current)
            count += 1
        current += 1

except ValueError:
    print("Ошибка обработки данных!")
