# Вариант 18. Задание 2. Дано число R и список размера N. Найти два различных элемента списка, сумма которых наиболее близка к числу R, и вывести эти элементы в порядке возрастания их индексов (определение наиболее близких чисел - то есть такой элемент AK, для которого величина |AK - R| является минимальной).

try:
    r = input("Введите число R: ")
    while type(r) != float:
        try:
            r = float(r)
        except ValueError:
            print("Неправильно ввели!")
            r = input("Введите число R: ")

    n = input("Введите размер списка N (N > 1): ")
    while type(n) != int:
        try:
            n = int(n)
            if n <= 1:
                print("Размер должен быть больше 1!")
                n = input("Введите размер списка N (N > 1): ")
        except ValueError:
            print("Неправильно ввели!")
            n = input("Введите размер списка N (N > 1): ")

    a = []
    for i in range(n):
        val = input(f"Введите элемент списка [{i}]: ")
        while type(val) != float:
            try:
                val = float(val)
            except ValueError:
                print("Неправильно ввели!")
                val = input(f"Введите элемент списка [{i}]: ")
        a.append(val)

    print("Исходный список:", a)

    min_diff = float('inf')
    idx1, idx2 = -1, -1

    for i in range(n):
        for j in range(i + 1, n):
            current_sum = a[i] + a[j]
            diff = abs(current_sum - r)
            if diff < min_diff:
                min_diff = diff
                idx1, idx2 = i, j

    print(f"Элементы: {a[idx1]} (индекс {idx1}) и {a[idx2]} (индекс {idx2})")

except Exception:
    print("Ошибка обработки данных!")
