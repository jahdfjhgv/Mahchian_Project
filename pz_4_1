# Вариант 18. Задание 1. Дано вещественное число X и целое число N (> 0). Найти значение выражения 1 + X + X2/(2!) + ... + XN/(N!) (N! = 12 ...N). Полученное число является приближенным значением функции exp в точке X.

try:
    x = input("Введите вещественное число X: ")
    while type(x) != float:
        try:
            x = float(x)
        except ValueError:
            print("Неправильно ввели!")
            x = input("Введите вещественное число X: ")

    n = input("Введите целое число N (> 0): ")
    while type(n) != int:
        try:
            n = int(n)
            if n <= 0:
                print("Число N должно быть больше 0!")
                n = input("Введите целое число N (> 0): ")
        except ValueError:
            print("Неправильно ввели!")
            n = input("Введите целое число N (> 0): ")

    result = 1.0
    term = 1.0

    for i in range(1, n + 1):
        term *= x / i
        result += term

    print(result)

except ValueError:
    print("Ошибка обработки данных!")
