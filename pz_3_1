# Вариант 18. Задание 1. Дано целое положительное число. Проверить истинность высказывания: «Данное число является нечетным трехзначным».

try:
    a = input("Введите целое положительное число: ")

    while type(a) != int:
        try:
            a = int(a)
            if a <= 0:
                print("Число должно быть положительным!")
                a = input("Введите целое положительное число: ")
        except ValueError:
            print("Неправильно ввели!")
            a = input("Введите целое положительное число: ")

    is_odd_three_digit = (100 <= a <= 999) and (a % 2 != 0)

    print(is_odd_three_digit)

except ValueError:
    print("Ошибка обработки данных!")
