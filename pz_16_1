#Создайте класс «Круг», который имеет атрибут радиуса и методы для вычисления
#площади, длины окружности и диаметра.


import math


class Circle:
    """Класс Круг."""

    def __init__(self, radius):
        self.radius = radius

    def area(self):
        """Площадь круга."""
        return math.pi * self.radius ** 2

    def circumference(self):
        """Длина окружности."""
        return 2 * math.pi * self.radius

    def diameter(self):
        """Диаметр."""
        return 2 * self.radius


circle = Circle(5)

print("Радиус:", circle.radius)
print("Площадь:", round(circle.area(), 2))
print("Длина окружности:", round(circle.circumference(), 2))
print("Диаметр:", circle.diameter())
