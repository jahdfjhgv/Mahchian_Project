# Вариант 18. Задание 2. Описать функцию PowerA234(A, B, C, D), вычисляющую вторую, третью и четвертую степень числа A и возвращающую эти степени соответственно в переменные B, C и D (A — входной, B, C, D — выходные параметры; все параметры являются вещественными). С помощью этой функции найти вторую, третью и четвертую степень пяти данных чисел.

def power_a234(a):
    b = a ** 2
    c = a ** 3
    d = a ** 4
    return b, c, d

try:
    numbers = []
    for i in range(1, 6):
        user_input = input(f"Введите вещественное число №{i}: ")
        while type(user_input) != float:
            try:
                user_input = float(user_input)
            except ValueError:
                print("Неправильно ввели!")
                user_input = input(f"Введите вещественное число №{i}: ")
        numbers.append(user_input)

    for num in numbers:
        pow2, pow3, pow4 = power_a234(num)
        print(f"Число: {num} | Квадрат: {pow2} | Куб: {pow3} | 4-я степень: {pow4}")

except ValueError:
    print("Ошибка обработки данных!")
